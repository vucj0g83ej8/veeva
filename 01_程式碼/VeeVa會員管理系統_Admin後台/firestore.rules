rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    match /newsHelpfulVotes/{voteId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if true;
    }

    match /rewardVouchers/{voucherId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /members/{memberId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /reviewSubmissions/{reviewId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /referrals/{referralId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /memberRewardClaims/{claimId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /memberRewards/{rewardGrantId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /memberNotifications/{notificationId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /lineMessageTests/{testId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /phoneVerificationRateLimits/{phoneHash} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /systemSettings/{settingId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /activityRegistrations/{registrationId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /activityCompletions/{completionId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /employeeActivityLinks/{linkId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /employeeQrVisits/{visitId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /memberEmployeeAttributions/{attributionId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    match /adminUsers/{adminUserId} {
      allow read, create, update: if true;
      allow delete: if true;
    }
  }
}
